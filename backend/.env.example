# Copy to backend/.env for local development (never commit .env).

# Local dev defaults to DEBUG=True with an insecure built-in key.
DJANGO_DEBUG=True

# REQUIRED when DJANGO_DEBUG=False. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# Public website URL (used by the admin panel's "Website" link)
FRONTEND_URL=http://localhost:5173

# JWT access token lifetime in minutes (refresh token: 7 days)
JWT_ACCESS_MINUTES=60

# Rate limits (DRF format: N/sec|min|hour|day)
THROTTLE_ANON=300/min
THROTTLE_USER=1000/min
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/hour
THROTTLE_INQUIRY=10/hour
THROTTLE_VIEW=120/hour
